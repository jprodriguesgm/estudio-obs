#!/bin/bash
# transcribe de mentira: um .srt por vídeo e o SRT único quando há 2 ou mais
cd "$1" || exit 1
n=0
for v in *.mov *.mp4; do [ -f "$v" ] || continue; printf '1\n00:00:00,000 --> 00:00:01,000\nOlá\n' > "${v%.*}.srt"; n=$((n+1)); echo "Transcrevendo $v"; done
if [ $n -ge 2 ]; then echo x > "SRT unico - Footage.srt"; echo t > "SRT unico - tabela.txt"; fi
echo "Pronto!"
